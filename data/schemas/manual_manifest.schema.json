{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maintain-ai.local/schemas/manual_manifest.schema.json",
  "title": "Synthetic manual manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "provenance", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "provenance": {"const": "synthetic"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tenant_id", "machine_model", "title", "path", "version", "document_kind", "content_trust", "sections"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "tenant_id": {"type": "string", "minLength": 1},
          "machine_model": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^[a-z0-9-]+\\.md$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "document_kind": {"enum": ["equipment_manual", "adversarial_fixture"]},
          "content_trust": {"const": "untrusted"},
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["section_id", "heading", "source_reference", "keywords"],
              "properties": {
                "section_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
                "heading": {"type": "string", "minLength": 1},
                "source_reference": {"type": "string", "minLength": 1},
                "keywords": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
