{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maintain-ai.local/schemas/incidents.schema.json",
  "title": "Synthetic incident seed envelope",
  "type": "object",
  "required": ["schema_version", "generated_at", "provenance", "records"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "provenance": {"const": "synthetic"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "tenant_id", "machine_id", "title", "description", "resolution", "occurred_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^INC-[AB]-[0-9]{3}$"},
          "tenant_id": {"type": "string", "minLength": 1},
          "machine_id": {"type": "string", "pattern": "^[AB][12]$"},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "resolution": {"type": "string", "minLength": 1},
          "occurred_at": {"type": "string", "format": "date-time"},
          "alarm_code": {"type": ["string", "null"]},
          "downtime_minutes": {"type": "integer", "minimum": 0},
          "source_reference": {"type": "string", "minLength": 1},
          "content_trust": {"const": "untrusted"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
