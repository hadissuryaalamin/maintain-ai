# Copy to .env. Never commit real credentials.
# Production mode rejects SQLite, automatic seed data, and demo-header authentication.
APP_ENV=development
DATABASE_URL=sqlite:///./maintenance_copilot.db
# Optional Docker Compose override; its default uses the persistent /data volume.
COMPOSE_DATABASE_URL=

# LLM provider: "demo" runs fully offline; "openai" uses the Responses API adapter;
# "anthropic" uses the Claude Messages API adapter. Switch provider and model names together:
#   openai:    DEFAULT_MODEL=gpt-5.6-terra      SMALL_MODEL=gpt-5.6-luna
#   anthropic: DEFAULT_MODEL=claude-sonnet-5-5  SMALL_MODEL=claude-haiku-5-5
# API credit is billed separately from ChatGPT/Claude app subscriptions.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
DEFAULT_MODEL=gpt-5.6-terra
SMALL_MODEL=gpt-5.6-luna
DEMO_MODEL=demo-maintenance-v1
MODEL_PRICING_PATH=config/model_pricing.yaml
DATA_PATH=data
AUTO_SEED=true

# Optional synthetic AI4I model tool. Start EC2 and the laptop tunnel manually.
# Keep disabled for ordinary offline/demo runs. In Docker, localhost means that container.
FAILURE_PREDICTION_ENABLED=false
FAILURE_PREDICTION_BASE_URL=http://127.0.0.1:8003
FAILURE_PREDICTION_TIMEOUT_SECONDS=5

MAX_AGENT_STEPS=6
MAX_TOOL_CALLS=10
REQUEST_TIMEOUT_SECONDS=45
MAX_OUTPUT_TOKENS=1800
MAX_REQUEST_INPUT_CHARACTERS=250000
MAX_PROVIDER_INPUT_CHARACTERS=120000
PROVIDER_MAX_RETRIES=2
HISTORY_MESSAGE_LIMIT=8
HISTORY_CHARACTER_LIMIT=12000
RETRIEVAL_CHUNK_LIMIT=4
BASELINE_RETRIEVAL_CHUNK_LIMIT=12

# The sample app uses trusted development headers, not production authentication.
ALLOW_DEMO_AUTH=true
STORE_PROMPT_PREVIEW=false
STORE_TOOL_PAYLOADS=false
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# Used by a dashboard process started outside Compose.
API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_PORT=8501
DASHBOARD_ALLOW_API_URL_EDIT=false
DEMO_TENANT_ID=company-a
DEMO_USER_ID=user-a-tech
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_TENANT_ID=company-a
MCP_USER_ID=user-a-tech
